local function SetNoclip(state)
    if state then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                local char = Players.LocalPlayer.Character
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

local function NukeBrazilPortal()
    local lobby = workspace:FindFirstChild("Lobby")
    if not lobby then return end
    local brazil = lobby:FindFirstChild("brazil")
    if not brazil then return end

    for _, v in pairs(brazil:GetDescendants()) do
        if v:IsA("BasePart") then
            pcall(function()
                v.CanTouch = false
                v.CanCollide = false
                v.CFrame = CFrame.new(0, -10000, 0)
                v.Size = Vector3.new(0.1, 0.1, 0.1)
            end)
        end
    end

    pcall(function()
        if brazil:IsA("Model") then
            brazil:PivotTo(CFrame.new(0, -10000, 0))
        end
    end)
end

local function EnterArena()
    NukeBrazilPortal()

    local char = Players.LocalPlayer.Character
    if not char then return end
    if not char:FindFirstChild("HumanoidRootPart") then return end
    if char:FindFirstChild("entered") then return end

    local lobby = workspace:FindFirstChild("Lobby")
    if not lobby then return end

    local tp1 = lobby:FindFirstChild("Teleport1")
    if not tp1 then return end

    local hrp = char.HumanoidRootPart

    pcall(function()
        hrp.CFrame = tp1.CFrame * CFrame.new(0, 3, 0)
        hrp.AssemblyLinearVelocity = Vector3.zero
    end)

    task.wait(0.2)

    pcall(function()
        firetouchinterest(hrp, tp1, 0)
        task.wait(0.1)
        firetouchinterest(hrp, tp1, 1)
    end)
end

local function GetSlappleTouchPart(slapple)
    if slapple:FindFirstChild("Glove") and slapple.Glove:IsA("BasePart") then
        return slapple.Glove
    end
    if slapple:IsA("BasePart") then
        return slapple
    end
    for _, child in ipairs(slapple:GetChildren()) do
        if child:IsA("BasePart") then
            return child
        end
    end
    return nil
end

local function CollectAllSlapples()
    local char = Players.LocalPlayer.Character
    if not char then return 0 end
    if not char:FindFirstChild("entered") then return 0 end
    if not char:FindFirstChild("HumanoidRootPart") then return 0 end

    local hrp = char.HumanoidRootPart
    local arena = workspace:FindFirstChild("Arena")
    if not arena then return 0 end

    local island5 = arena:FindFirstChild("island5")
    if not island5 then return 0 end

    local slapples = island5:FindFirstChild("Slapples")
    if not slapples then return 0 end

    local safePos = island5:GetPivot() * CFrame.new(0, -15, 0)
    safePlatform.CFrame = island5:GetPivot() * CFrame.new(0, -17, 0)

    pcall(function()
        hrp.CFrame = safePos
        hrp.AssemblyLinearVelocity = Vector3.zero
    end)

    task.wait(0.5)

    local count = 0

    for _, slapple in ipairs(slapples:GetChildren()) do
        if not _G.SlappleFarm then break end

        if slapple.Name:find("Slapple") then
            local part = GetSlappleTouchPart(slapple)
            if part then
                pcall(function()
                    firetouchinterest(hrp, part, 0)
                    task.wait(0.02)
                    firetouchinterest(hrp, part, 1)
                end)
                count = count + 1
                task.wait(0.04)
            end
        end
    end

    return count
end

-- ====================== SERVER HOP ======================
function DoServerHop()
    if _G.IsHopping then return end
    _G.IsHopping = true
    _G.AllowTeleport = true

    SaveSettings()

    pcall(function()
        OrionLib:MakeNotification({
            Name = "Server Hop 🚀",
            Content = "Перехід на новий сервер...",
            Image = "rbxassetid://7734053426",
            Time = 2
        })
    end)

    if _G.AutoExecute then
        local q = nil
        pcall(function() q = queue_on_teleport end)
        if not q then pcall(function() q = queueonteleport end) end
        if not q and getgenv then pcall(function() q = getgenv().queue_on_teleport end) end

        if q then
            pcall(function()
                q('repeat task.wait() until game:IsLoaded(); loadstring(game:HttpGet("' .. GITHUB_RAW_URL .. '?v=' .. tostring(tick()) .. '"))()')
            end)
        end
    end

    local placeId = game.PlaceId
    local jobId = game.JobId
    local targetServerId = nil

    local ok, response = pcall(function()
        return game:HttpGet("https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Asc&limit=100")
    end)

    if ok and response then
        local dok, decoded = pcall(function() return HttpService:JSONDecode(response) end)
        if dok and decoded and decoded.data then
            local list = {}
            for _, s in ipairs(decoded.data) do
                if type(s) == "table" and s.playing and s.maxPlayers and s.playing < s.maxPlayers and s.id ~= jobId then
                    table.insert(list, s.id)
                end
            end
            if #list > 0 then
                targetServerId = list[math.random(1, #list)]
            end
        end
    end

    pcall(function()
        if targetServerId then
            TeleportService:TeleportToPlaceInstance(placeId, targetServerId, Players.LocalPlayer)
        else
            TeleportService:Teleport(placeId, Players.LocalPlayer)
        end
    end)

    task.delay(6, function()
        _G.IsHopping = false
        _G.AllowTeleport = false
    end)
end

