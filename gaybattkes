if not game:IsLoaded() then game.Loaded:Wait() end

local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")

-- 📌 ВКАЖИ СВОЄ RAW ПОСИЛАННЯ З GITHUB ТУТ:
local GITHUB_RAW_URL = "https://raw.githubusercontent.com/ТВІЙ_НІК/ТВІЙ_РЕПО/main/script.lua"

local ConfigFile = "SlappleFarm_Settings.json"

-- Змінна-дозвіл на телепорт (за замовчуванням заблоковано)
_G.AllowScriptHop = false

-- 🛡️ 1. БЛОКУВАННЯ БУДЬ-ЯКИХ ТЕЛЕПОРТІВ ГРИ (БРАЗИЛІЯ ТОЩО)
if hookmetamethod and not _G.TeleportBlockedHook then
    _G.TeleportBlockedHook = true
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()
        
        -- Якщо гра намагається викликати будь-який метод телепорту
        if self == TeleportService and (method == "Teleport" or method == "TeleportToPlaceInstance" or method == "TeleportAsync") then
            if not _G.AllowScriptHop then
                -- Блокуємо телепорт від гри
                return nil
            end
        end
        
        return oldNamecall(self, ...)
    end))
end

-- Ініціалізація глобальних змінних
if _G.SlappleFarm == nil then _G.SlappleFarm = false end
if _G.AutoEnterArena == nil then _G.AutoEnterArena = false end
if _G.ServerHopWhenEmpty == nil then _G.ServerHopWhenEmpty = false end

-- 2. Завантаження конфігурації
local function LoadSettings()
    if isfile and readfile and isfile(ConfigFile) then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(ConfigFile))
        end)
        if success and type(result) == "table" then
            _G.SlappleFarm = result.SlappleFarm or false
            _G.AutoEnterArena = result.AutoEnterArena or false
            _G.ServerHopWhenEmpty = result.ServerHopWhenEmpty or false
        end
    end
end

-- 3. Збереження конфігурації
local function SaveSettings()
    if writefile then
        pcall(function()
            writefile(ConfigFile, HttpService:JSONEncode({
                SlappleFarm = _G.SlappleFarm,
                AutoEnterArena = _G.AutoEnterArena,
                ServerHopWhenEmpty = _G.ServerHopWhenEmpty
            }))
        end)
    end
end

LoadSettings()

-- 4. Додаткове вимкнення деталі Бразилії
local function DisableBrazilPortal()
    local lobby = workspace:FindFirstChild("Lobby")
    if lobby then
        local brazil = lobby:FindFirstChild("brazil")
        if brazil then
            for _, v in pairs(brazil:GetDescendants()) do
                if v:IsA("BasePart") and v.CanTouch then
                    v.CanTouch = false
                end
            end
        end
    end
end

-- 5. Контрольований Server Hop
function DoServerHop()
    if _G.IsHopping then return end
    _G.IsHopping = true

    SaveSettings()

    -- 🔓 ТИМЧАСОВО ДОЗВОЛЯЄМО ТЕЛЕПОРТ ДЛЯ НАШОГО С КРИПТА
    _G.AllowScriptHop = true

    -- Авто-екзекют для нового сервера
    local queue_teleport = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    if queue_teleport and GITHUB_RAW_URL ~= "https://raw.githubusercontent.com/ТВІЙ_НІК/ТВІЙ_РЕПО/main/script.lua" then
        pcall(function()
            queue_teleport([[
                repeat task.wait() until game:IsLoaded() and game.Players.LocalPlayer
                loadstring(game:HttpGet("]] .. GITHUB_RAW_URL .. [[?v=]] .. tostring(tick()) .. [["))()
            ]])
        end)
    end

    local placeId = game.PlaceId
    local jobId = game.JobId
    local targetServerId = nil

    local success, response = pcall(function()
        return game:HttpGet("https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Asc&limit=100")
    end)

    if success and response then
        local decodeSuccess, decoded = pcall(function() return HttpService:JSONDecode(response) end)
        if decodeSuccess and decoded and decoded.data then
            local validServers = {}
            for _, server in ipairs(decoded.data) do
                if type(server) == "table" and server.playing and server.maxPlayers and server.playing < server.maxPlayers and server.id ~= jobId then
                    table.insert(validServers, server.id)
                end
            end
            if #validServers > 0 then
                targetServerId = validServers[math.random(1, #validServers)]
            end
        end
    end

    if targetServerId then
        local tpSuccess = pcall(function()
            TeleportService:TeleportToPlaceInstance(placeId, targetServerId, Players.LocalPlayer)
        end)
        if not tpSuccess then
            pcall(function() TeleportService:Teleport(placeId, Players.LocalPlayer) end)
        end
    else
        pcall(function() TeleportService:Teleport(placeId, Players.LocalPlayer) end)
    end

    task.wait(6)
    _G.AllowScriptHop = false
    _G.IsHopping = false
end

-- 6. Перехоплення помилок телепорту
if not _G.TeleportHooked then
    _G.TeleportHooked = true
    TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
        if player == Players.LocalPlayer then
            _G.IsHopping = false
            _G.AllowScriptHop = false
            task.wait(2)
            if _G.ServerHopWhenEmpty or _G.SlappleFarm then
                DoServerHop()
            end
        end
    end)
end

-- 7. Безпечний вхід на арену
local function EnterArena()
    DisableBrazilPortal()
    
    local char = Players.LocalPlayer.Character
    if char and char:FindFirstChild("Head") and not char:FindFirstChild("entered") then
        local lobby = workspace:FindFirstChild("Lobby")
        if lobby then
            local tp = lobby:FindFirstChild("Teleport1")
            if tp then
                firetouchinterest(char.Head, tp, 0)
                firetouchinterest(char.Head, tp, 1)
            end
        end
    end
end

-- 8. Безпечний збір слеплів
local function CollectSlapples()
    local char = Players.LocalPlayer.Character
    local collectedInLoop = 0
    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("entered") then
        local arena = workspace:FindFirstChild("Arena")
        if arena then
            local island5 = arena:FindFirstChild("island5")
            if island5 then
                local slapples = island5:FindFirstChild("Slapples")
                if slapples then
                    for _, v in pairs(slapples:GetChildren()) do
                        if (v.Name == "Slapple" or v.Name == "GoldenSlapple") and v:FindFirstChild("Glove") and v.Glove:FindFirstChildWhichIsA("TouchTransmitter") then
                            collectedInLoop = collectedInLoop + 1
                            firetouchinterest(char.HumanoidRootPart, v.Glove, 0)
                            firetouchinterest(char.HumanoidRootPart, v.Glove, 1)
                            task.wait(0.05)
                        end
                    end
                end
            end
        end
    end
    return collectedInLoop
end

-- Фонова перевірка
task.spawn(function()
    while true do
        DisableBrazilPortal()
        task.wait(3)
    end
end)

