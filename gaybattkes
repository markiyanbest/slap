    local oldNamecall = nil
    oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local method = getnamecallmethod()

        if self == TeleportService and (method:find("Teleport") or method:find("TeleportAsync")) then
            if not _G.AllowTeleport then return end
        end

        if method == "FireServer" or method == "InvokeServer" then
            local name = self.Name
            if name == "Kicker" or name == "Ban" or name == "LogTunnel" or name == "ModerationRemote" then
                return
            end
        end

        return oldNamecall(self, ...)
    end))
end

