local function LoadSettings()
    if isfile and readfile and isfile(ConfigFile) then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(ConfigFile))
        end)
        if ok and type(data) == "table" then
            _G.SlappleFarm = data.SlappleFarm or false
            _G.AutoEnterArena = data.AutoEnterArena or false
            _G.AutoExecute = data.AutoExecute ~= nil and data.AutoExecute or true
        end
    end
end

local function SaveSettings()
    if isInitializing or not writefile then return end
    pcall(function()
        writefile(ConfigFile, HttpService:JSONEncode({
            SlappleFarm = _G.SlappleFarm,
            AutoEnterArena = _G.AutoEnterArena,
            AutoExecute = _G.AutoExecute
        }))
    end)
end

