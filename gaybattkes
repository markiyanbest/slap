-- 6. Функція входу на арену 
local function EnterArena() 
    DisableBrazilPortal()
    local char = Players.LocalPlayer.Character 
    if char and char:FindFirstChild("Head") and not char:FindFirstChild("entered") then 
        local lobby = workspace:FindFirstChild("Lobby")
        if lobby and lobby:FindFirstChild("Teleport1") then 
            firetouchinterest(char.Head, lobby.Teleport1, 0) 
            firetouchinterest(char.Head, lobby.Teleport1, 1) 
        end 
    end 
end 

-- 7. Збір під землею (Underground Position + Noclip)
local function CollectSlapplesUnderground()
    local char = Players.LocalPlayer.Character
    local collectedInLoop = 0

    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("entered") then 
        local hrp = char.HumanoidRootPart
        local arena = workspace:FindFirstChild("Arena")

        if arena and arena:FindFirstChild("island5") and arena.island5:FindFirstChild("Slapples") then 
            local slappleContainer = arena.island5.Slapples
            local items = slappleContainer:GetChildren()

            -- Фіксуємо персонажа ПІД землею острова (-8 блоків вниз)
            pcall(function()
                hrp.CFrame = arena.island5.CFrame * CFrame.new(0, -8, 0)
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
            task.wait(0.2)

            if #items > 0 then
                for _, v in pairs(items) do 
                    if (v.Name == "Slapple" or v.Name == "GoldenSlapple") and v:FindFirstChild("Glove") and v.Glove:FindFirstChildWhichIsA("TouchTransmitter") then 
                        collectedInLoop = collectedInLoop + 1 
                        
                        -- Збір дистанційно через TouchTransmitter
                        firetouchinterest(hrp, v.Glove, 0) 
                        firetouchinterest(hrp, v.Glove, 1) 
                        
                        task.wait(math.random(15, 25) / 100) 
                    end 
                end 
            end
        end 
    end 
    return collectedInLoop
end

-- 8. Server Hop
function DoServerHop() 
    if _G.IsHopping then return end 
    _G.IsHopping = true 

    SaveSettings() 

    OrionLib:MakeNotification({ 
        Name = "Server Hop", 
        Content = "Шукаємо новий сервер...", 
        Image = "rbxassetid://7734053426", 
        Time = 3 
    }) 

    if _G.AutoExecute then 
        local q = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport) or (getgenv and (getgenv().queue_on_teleport or getgenv().queueonteleport))
        
        if q then 
            pcall(function() 
                q('repeat task.wait() until game:IsLoaded(); loadstring(game:HttpGet("' .. GITHUB_RAW_URL .. '?v=' .. tostring(tick()) .. '"))()')
            end) 
        end 
    end 

    local placeId = game.PlaceId 
    local jobId = game.JobId 
    local targetServerId = nil 

    local success, response = pcall(function() 
        return game:HttpGet("https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Asc&limit=100") 
    end) 

    if success and response then 
        local decodeSuccess, decoded = pcall(function() return HttpService:JSONDecode(response) end) 
        if decodeSuccess and decoded and decoded.data then 
            local validServers = {} 
            for _, server in ipairs(decoded.data) do 
                if type(server) == "table" and server.playing and server.maxPlayers and server.playing < server.maxPlayers and server.id ~= jobId then 
                    table.insert(validServers, server.id) 
                end 
            end 
            if #validServers > 0 then 
                targetServerId = validServers[math.random(1, #validServers)] 
            end 
        end 
    end 

    if targetServerId then 
        local tpSuccess = pcall(function() 
            TeleportService:TeleportToPlaceInstance(placeId, targetServerId, Players.LocalPlayer) 
        end) 
        if not tpSuccess then 
            TeleportService:Teleport(placeId, Players.LocalPlayer) 
        end 
    else 
        TeleportService:Teleport(placeId, Players.LocalPlayer) 
    end 

    task.delay(7, function()
        _G.IsHopping = false 
    end)
end 

-- 9. Вкладки та UI
local Tab = Window:MakeTab({ 
    Name = "Slapples Farm", 
    Icon = "rbxassetid://7733673987", 
    PremiumOnly = false 
}) 

Tab:AddToggle({ 
    Name = "Autofarm Slapples (Під землею)", 
    Default = _G.SlappleFarm, 
    Callback = function(Value) 
        _G.SlappleFarm = Value 
        SaveSettings() 
        SetNoclip(Value)

        if Value then 
            task.spawn(function() 
                local emptyChecks = 0

                while _G.SlappleFarm do 
                    local char = Players.LocalPlayer.Character 
                    
                    if char and not char:FindFirstChild("entered") then 
                        EnterArena() 
                        task.wait(1) 
                    end 

                    local collectedInLoop = CollectSlapplesUnderground()

                    if collectedInLoop == 0 then
                        emptyChecks = emptyChecks + 1
                    else
                        emptyChecks = 0
                    end

                    -- Якщо дерево порожнє більше 3 циклів перевірки (близько 6-8 сек), робимо Server Hop
                    if _G.ServerHopWhenEmpty and emptyChecks >= 3 and char and char:FindFirstChild("entered") and not _G.IsHopping then 
                        OrionLib:MakeNotification({ 
                            Name = "Slapple Farm", 
                            Content = "Дерево порожнє. Міняємо сервер...", 
                            Image = "rbxassetid://7734053426", 
                            Time = 3 
                        }) 
                        
                        task.wait(1) 
                        DoServerHop() 
                        break
                    end 
                    
                    task.wait(1) 
                end 
            end) 
        end 
    end 
}) 

Tab:AddToggle({ 
    Name = "Auto Enter Arena", 
    Default = _G.AutoEnterArena, 
    Callback = function(Value) 
        _G.AutoEnterArena = Value 
        SaveSettings() 

        if Value then 
