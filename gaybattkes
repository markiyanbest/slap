local function SetNoclip(state)
    if state then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                local char = Players.LocalPlayer.Character
                if char then
                    for _, part in pairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    elseif noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
end

local function NukeBrazilPortal()
    local lobby = workspace:FindFirstChild("Lobby")
    if not lobby then return end
    local brazil = lobby:FindFirstChild("brazil")
    if not brazil then return end

    for _, v in pairs(brazil:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanTouch = false
            v.CanCollide = false
            v.CFrame = CFrame.new(0, -10000, 0)
            v.Size = Vector3.new(0.1, 0.1, 0.1)
        end
    end
    if brazil:IsA("Model") then
        brazil:PivotTo(CFrame.new(0, -10000, 0))
    end
end

local function EnterArena()
    NukeBrazilPortal()
    local char = Players.LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("entered") then return end

    local lobby = workspace:FindFirstChild("Lobby")
    local tp1 = lobby and lobby:FindFirstChild("Teleport1")
    if tp1 then
        local hrp = char.HumanoidRootPart
        hrp.CFrame = tp1.CFrame * CFrame.new(0, 3, 0)
        task.wait(0.2)
        firetouchinterest(hrp, tp1, 0)
        task.wait(0.1)
        firetouchinterest(hrp, tp1, 1)
    end
end

local function GetSlappleTouchPart(slapple)
    if slapple:FindFirstChild("Glove") then return slapple.Glove end
    if slapple:IsA("BasePart") then return slapple end
    for _, child in ipairs(slapple:GetChildren()) do
        if child:IsA("BasePart") then return child end
    end
    return nil
end

local function CollectAllSlapples()
    local char = Players.LocalPlayer.Character
    if not char or not char:FindFirstChild("entered") then return 0 end

    local hrp = char.HumanoidRootPart
    local arena = workspace:FindFirstChild("Arena")
    if not arena or not arena:FindFirstChild("island5") then return 0 end

    local slapples = arena.island5:FindFirstChild("Slapples")
    if not slapples then return 0 end

    local count = 0
    local safePos = arena.island5:GetPivot() * CFrame.new(0, -15, 0)
    hrp.CFrame = safePos

    for _, slapple in ipairs(slapples:GetChildren()) do
        if slapple.Name:find("Slapple") then
            local part = GetSlappleTouchPart(slapple)
            if part then
                firetouchinterest(hrp, part, 0)
                task.wait(0.02)
                firetouchinterest(hrp, part, 1)
                count += 1
                task.wait(0.04)
            end
        end
    end
    return count
end

function DoServerHop()
    if _G.IsHopping then return end
    _G.IsHopping = true
    _G.AllowTeleport = true

    SaveSettings()

    OrionLib:MakeNotification({
        Name = "Server Hop",
        Content = "Перехід на новий сервер...",
        Image = "rbxassetid://7734053426",
        Time = 2
    })

    if _G.AutoExecute then
        local q = queue_on_teleport or queueonteleport or (getgenv and getgenv().queue_on_teleport)
        if q then
            q('repeat task.wait() until game:IsLoaded(); loadstring(game:HttpGet("' .. GITHUB_RAW_URL .. '?v=' .. tick() .. '"))()')
        end
    end

    TeleportService:Teleport(game.PlaceId)
end

