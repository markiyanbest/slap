Tab:AddToggle({
    Name = "Autofarm Slapples + Auto Hop",
    Default = _G.SlappleFarm,
    Callback = function(Value)
        _G.SlappleFarm = Value
        SaveSettings()
        SetNoclip(Value)

        if Value then
            task.spawn(function()
                local serverStartTime = tick()

                while _G.SlappleFarm do
                    -- 30 секунд таймер (якщо застряг у Бразилії або будь-де)
                    if tick() - serverStartTime > 30 then
                        OrionLib:MakeNotification({
                            Name = "30s Таймер",
                            Content = "Перевищено ліміт часу. Виконую Server Hop...",
                            Image = "rbxassetid://7734053426",
                            Time = 3
                        })
                        task.wait(0.7)
                        DoServerHop()
                        break
                    end

                    local char = Players.LocalPlayer.Character

                    if char and not char:FindFirstChild("entered") then
                        EnterArena()
                        task.wait(1.2)
                    end

                    if char and char:FindFirstChild("entered") then
                        local collected = CollectAllSlapples()

                        OrionLib:MakeNotification({
                            Name = "Farm Result",
                            Content = collected > 0 and "Зібрано " .. collected .. " яблук. Перехід..." or "Яблук немає. Перехід...",
                            Image = "rbxassetid://7734053426",
                            Time = 2.5
                        })

                        task.wait(0.8)
                        DoServerHop()
                        break
                    end

                    task.wait(0.5)
                end
            end)
        end
    end
})

